# ╔═══════════════════════════════════════════════════════════════════╗
# ║  بيئتان، ملفّان                                                    ║
# ╚═══════════════════════════════════════════════════════════════════╝
#
#   .env        التطوير — الحزمة المحلّية على هذه الآلة. انسخ هذا الملفّ إليه.
#   .env.prod   الإنتاج — مشروع Supabase الحقيقي. لا يقرأه إلّا أمر فيه --prod.
#
# كلاهما خارج git. والافتراضي هو غير المؤذي: أمر بلا --prod لا يلمس
# الإنتاج أبداً، والكتابة في الإنتاج تحتاج ALLOW_PROD_WRITE=1 فوق ذلك.
# والحارس يميّز الإنتاج **بعنوانه** لا باسم ملفّه (scripts/lib/env.mjs):
# ملفّ اسمه .env يشير إلى مشروع الإنتاج يُعامَل معاملة الإنتاج.
#
# ── للتطوير، ثلاثة أوامر ──
#   npm run db:start     يشغّل الحزمة المحلّية (يحتاج Docker Desktop)
#   npm run migrate      يطبّق الهجرات الـ56 عليها
#   node scripts/seed-demo.mjs     بيانات تجريبية موسومة is_demo
#
#   npm run db:reset     يمسح ويعيد البناء من الصفر
#   npm run db:stop      يطفئ الحزمة
#   npm run db:backup    ينسخ الإنتاج ثمّ --restore يسترجعها محلّياً ويقارن
#
# ═══════════════════════════════════════════════ القيم المحلّية (انسخها كما هي)
#
# المنافذ 5433x خاصة بهذا المشروع — على هذه الآلة حزم محلّية أخرى تحجز 5432x.
#
# المفتاحان أسفله يطبعهما `npm run db:start` عند الإقلاع
# (PUBLISHABLE_KEY وSECRET_KEY). انسخهما من مخرجاته: مفاتيح حزمة تعيش
# على هذه الآلة وحدها، لكن لا تُكتب هنا — فاحص أسرار GitHub يحجب الدفع
# على صيغة sb_secret_ أياً كان مصدرها، وهو محقّ: الصيغة وحدها لا تقول
# إن كان المفتاح محلّياً أم إنتاجياً.

SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_PASSWORD=postgres
SUPABASE_DB_PORT=54332

NEXT_PUBLIC_SITE_URL=http://localhost:3100

# الإرسال القصير محلّياً: مستحيل لا مُعطَّل. المفتاح فارغ قصداً، فحتى
# لو انقلب SMS_ENABLED إلى true ما تخرج رسالة ولا يُحرق رصيد.
WINSMS_API_KEY=
WINSMS_SENDER=MAZED
SMS_ENABLED=false

# اختياري — المساعد الذكي. فارغ محلّياً.
OPENAI_API_KEY=

# ═══════════════════════════════════════════════ الدخول إلى اللوحة محلّياً
#
# حساب مالك للتطوير وحده، على نطاق محجوز لا وجود له:
#
#   printf 'labina-dev-2026\n' | node scripts/create-owner.mjs dev@allabina.invalid
#
#   البريد : dev@allabina.invalid
#   السرّ  : labina-dev-2026
#
# هذه كلمة سرّ قاعدةٍ تعيش على هذه الآلة وحدها وتُمسح مع npm run db:reset.
# لا تستعملها في أيّ مكان آخر، ولا تُنشئ حساباً بها على الإنتاج.
#
# ═══════════════════════════════════════════════ الإنتاج (.env.prod)
#
# نفس الأسماء أعلاه، بقيم مشروع Supabase:
#   https://supabase.com/dashboard/project/cssdvlhluaogdjcgnnga/settings/api-keys
#
#   SUPABASE_URL=https://cssdvlhluaogdjcgnnga.supabase.co
#   NEXT_PUBLIC_SUPABASE_URL=https://cssdvlhluaogdjcgnnga.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#   SUPABASE_SECRET_KEY=sb_secret_...        ← الخادم فقط، يتجاوز RLS
#   DATABASE_PASSWORD=...                    ← Settings > Database
#   NEXT_PUBLIC_SITE_URL=https://www.allabina.site
#   WINSMS_API_KEY=...                       ← رسائل مدفوعة حقيقية
#
# المفاتيح القديمة (anon/service_role بصيغة eyJ…) معطَّلة في مشروع الإنتاج.
# ولا يُوضع مفتاح سرّي أبداً في متغيّر يبدأ بـNEXT_PUBLIC_: ذاك يُرسَل للمتصفّح.
