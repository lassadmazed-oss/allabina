# Supabase — "ALLABINA Project" (ref: cssdvlhluaogdjcgnnga, Central EU / Frankfurt)
# انسخ هذا الملف إلى ".env" واملأ القيم الحقيقية من:
# https://supabase.com/dashboard/project/cssdvlhluaogdjcgnnga/settings/api-keys
# ملاحظة: المفاتيح القديمة (anon/service_role بصيغة eyJ…) معطَّلة في هذا المشروع.

SUPABASE_URL=https://cssdvlhluaogdjcgnnga.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://cssdvlhluaogdjcgnnga.supabase.co

# publishable — آمن في المتصفّح مع تفعيل RLS وسياسات صحيحة.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# secret — الخادم فقط، يتجاوز RLS. لا يُوضع أبداً في متغيّر NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Postgres — الخادم فقط. تُغيَّر من Settings > Database.
DATABASE_PASSWORD=your-db-password-here

# عنوان الموقع — يُستعمل في روابط المصادقة وإعادة التوجيه.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ملاحظة: لوحة القيادة /admin لم تعد تستعمل كلمة سرّ مشتركة.
# الدخول بالبريد وكلمة السرّ عبر Supabase Auth.
# لإنشاء حساب المالك الأوّل:  node scripts/create-owner.mjs <email>
